---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const pillars = [
  {
    num: '01',
    name: 'Design',
    desc: 'Aerospace-grade CAD modeling and detailed part design in Catia V5 — from concept geometry through drawing package, built to survive tolerance stack-up and downstream manufacturing.',
    deliverables: [
      '3D part & assembly modeling (Catia V5)',
      'GD&T-driven detail drawings',
      'Sheet metal & machined part design',
      'Fixture & tooling geometry',
      'Design change & revision control',
      'Vendor-ready drawing packages',
    ],
  },
  {
    num: '02',
    name: 'Manufacturing Engineering',
    desc: 'CNC program development and toolpath verification using Vericut — catching collisions, overtravel, and stock issues in simulation, before a spindle ever turns.',
    deliverables: [
      'CNC program review & verification',
      'Toolpath & G-code simulation (Vericut)',
      'Machine & control setup validation',
      'Cycle-time & feed/speed analysis',
      'Fixture-to-machine collision checks',
      'First-article support',
    ],
  },
  {
    num: '03',
    name: 'Consult',
    desc: 'Independent engineering advisory for teams that need a second set of eyes — design reviews, root-cause investigations, and technical due diligence without the overhead of a full-time hire.',
    deliverables: [
      'Design & drawing reviews',
      'Root-cause & failure investigation',
      'Technical due diligence',
      'Supplier & process audits',
      'Engineering documentation cleanup',
      'Standards & compliance checks',
    ],
  },
  {
    num: '04',
    name: 'Optimize',
    desc: 'Design-for-manufacturability passes that reduce part count, cycle time, and scrap — tightening the gap between what a drawing says and what the shop floor can actually hold.',
    deliverables: [
      'DFM / DFA design passes',
      'Weight & material reduction studies',
      'Tolerance stack-up analysis',
      'Cost & cycle-time reduction reviews',
      'Legacy part re-design',
      'Process bottleneck identification',
    ],
  },
  {
    num: '05',
    name: 'Systems & Tooling',
    desc: 'Production tooling and systems engineering built on Dassault Systèmes — fixture design and shop-floor systems integration for repeatable, audit-ready manufacturing.',
    deliverables: [
      'Production tooling design',
      'Fixture & jig engineering',
      'Shop-floor systems integration (Dassault Systèmes)',
      'Work instruction development',
      'Process documentation & SOPs',
      'Manufacturing readiness reviews',
    ],
  },
];

const licenses = [
  {
    letter: 'A',
    name: 'Catia V5',
    role: 'CAD / Product Design',
    status: 'Pending',
  },
  {
    letter: 'B',
    name: 'Vericut',
    role: 'CNC Simulation / Verification',
    status: 'Pending',
  },
  {
    letter: 'C',
    name: 'Dassault Systèmes',
    role: 'Production Tooling / Systems',
    status: 'Pending',
  },
];
---

<Layout title="Services" description="Aero Vector Engineering offers aerospace design, CNC manufacturing engineering, consulting, and design optimization services — built in Catia V5, Vericut, and Dassault Systèmes.">

<!-- DRAFT NOTICE — remove once copy is approved -->
<!-- All service descriptions on this page are placeholder copy drafted for Trent's review. -->

<!-- ── PAGE HERO ── -->
<section class="page-hero">
  <div class="blueprint-grid page-hero-grid" aria-hidden="true"></div>
  <div class="page-hero-inner">
    <div class="kicker fade-up d1">Services</div>
    <h1 class="page-headline fade-up d2">
      Design.<br><em>Consult. Optimize.</em>
    </h1>
    <p class="page-sub fade-up d3">
      Five disciplines, one aerospace-engineering practice. Every engagement is scoped to
      your part, your process, or your problem — no generic retainers.
    </p>
    <div class="dim-row fade-up d4">
      <div class="dim-cell"><span class="dim-val">Aerospace</span><span class="dim-label">Engineering</span></div>
      <div class="dim-cell"><span class="dim-val">05</span><span class="dim-label">Service Areas</span></div>
      <div class="dim-cell"><span class="dim-val">Project</span><span class="dim-label">&amp; Consulting</span></div>
    </div>
  </div>
</section>

<!-- ── SERVICE SCHEDULE ── -->
<div id="schedule" style="border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="dwg-header">
      <div class="dwg-tag">01</div>
      <div class="dwg-leader"></div>
      <h2 class="dwg-title">Service Schedule</h2>
      <div class="dwg-rule"></div>
    </div>

    <div class="specsheet">
      <div class="ss-headrow">
        <span class="ss-h-item">Item</span>
        <span class="ss-h-name">Designation</span>
        <span>Description / Deliverables</span>
      </div>
      {pillars.map((p) => (
        <div class="ss-row">
          <div class="ss-item">{p.num}</div>
          <div class="ss-body">
            <div class="ss-name">{p.name}</div>
            <p class="ss-desc">{p.desc}</p>
            <div class="ss-spec">
              {p.deliverables.map((d) => (
                <span>{d}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- ── SOFTWARE & LICENSING ── -->
<div id="software" style="background: var(--bg2); border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="dwg-header">
      <div class="dwg-tag">02</div>
      <div class="dwg-leader"></div>
      <h2 class="dwg-title">Software &amp; Licensing</h2>
      <div class="dwg-rule"></div>
    </div>

    <p class="software-intro">
      Work is built and verified in industry-standard aerospace tooling. Licensing for the
      platforms below is in progress — this section will be updated with license numbers
      once issued.
    </p>

    <div class="license-grid">
      {licenses.map((l) => (
        <div class="license-card">
          <div class="lic-stamp">Lic. {l.status}</div>
          <div class="datum-row" style="margin-bottom:18px;">
            <div class="datum-box">{l.letter}</div>
          </div>
          <div class="license-name">{l.name}</div>
          <div class="license-role">{l.role}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- ── CTA ── -->
<div class="cta-wrap">
  <div class="section">
    <div class="cta-panel frame">
      <span class="corner corner--tl" aria-hidden="true"></span>
      <span class="corner corner--tr" aria-hidden="true"></span>
      <span class="corner corner--bl" aria-hidden="true"></span>
      <span class="corner corner--br" aria-hidden="true"></span>
      <div class="kicker" style="justify-content:center;margin-bottom:18px;">Ready to Build</div>
      <h2 class="cta-headline">Have a Part.<br><em>Not a Plan?</em></h2>
      <p class="cta-sub">
        A free discovery call to understand the problem and assess fit. If it makes sense to
        move forward, you'll know exactly what the next step looks like.
      </p>
      <div class="cta-actions">
        <a href={`${base}contact/`} class="btn-primary">Start a Project</a>
        <a href={`${base}about/`} class="btn-ghost">About Us</a>
      </div>
    </div>
  </div>
</div>

</Layout>

<style>
  /* ── PAGE HERO ── */
  .page-hero {
    min-height: 46vh;
    padding-top: var(--nav-h);
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .page-hero-grid {
    mask-image: radial-gradient(ellipse 85% 75% at 50% 50%, black 15%, transparent 100%);
  }
  .page-hero-inner {
    position: relative; z-index: 2;
    max-width: 1200px; margin: 0 auto;
    padding: 72px 48px;
    width: 100%;
  }
  .page-headline {
    font-family: var(--f-display); font-weight: 700;
    font-size: clamp(40px, 5.5vw, 64px);
    line-height: 1; letter-spacing: 0.005em;
    text-transform: uppercase; color: var(--text);
    margin: 20px 0 24px;
  }
  .page-headline em { font-style: normal; color: var(--accent); display: block; }
  .page-sub {
    font-size: 15px; line-height: 1.7; color: var(--muted);
    max-width: 520px; margin-bottom: 36px;
  }

  /* ── SOFTWARE & LICENSING ── */
  .software-intro {
    font-size: 15px; line-height: 1.75; color: var(--muted);
    max-width: 600px; margin-bottom: 44px;
  }
  .license-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .license-card {
    background: var(--bg3);
    padding: 30px 28px;
    position: relative;
  }
  .lic-stamp {
    position: absolute; top: 24px; right: 24px;
    padding: 4px 9px; border: 1px solid var(--accent3);
    font-family: var(--f-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent2);
  }
  .license-name {
    font-family: var(--f-display); font-weight: 700; font-size: 22px; letter-spacing: 0.01em;
    text-transform: uppercase; color: var(--text); margin-bottom: 8px;
  }
  .license-role {
    font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.05em;
    color: var(--muted2);
  }

  /* ── CTA ── */
  .cta-wrap { background: var(--bg2); padding: 20px 0; }
  .cta-panel { padding: 64px 48px; text-align: center; background: var(--bg); }
  .cta-headline {
    font-family: var(--f-display); font-weight: 700;
    font-size: clamp(34px, 4vw, 50px); line-height: 1; text-transform: uppercase;
    color: var(--text); margin-bottom: 16px;
  }
  .cta-headline em { font-style: normal; color: var(--accent); display: block; }
  .cta-sub {
    font-size: 15px; color: var(--muted); margin-bottom: 32px;
    max-width: 460px; margin-inline: auto; line-height: 1.7;
  }
  .cta-actions { display: flex; gap: 14px; justify-content: center; align-items: center; flex-wrap: wrap; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .page-hero-inner { padding: 56px 24px; }
    .license-grid { grid-template-columns: 1fr; }
    .cta-panel { padding: 48px 24px; }
  }
</style>
