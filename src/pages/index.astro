---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Aerospace Engineering — Design | Consult | Optimize" description="Aero Vector Engineering delivers aerospace-grade design, CNC manufacturing engineering, and consulting for teams that need precision without a full engineering department.">

<!-- DRAFT NOTICE — placeholder copy throughout, pending Trent's review -->

<!-- HERO -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-inner">
    <div class="hero-left">
      <div class="hero-eyebrow fade-up d1">Freelance Aerospace Engineering</div>
      <h1 class="hero-headline fade-up d2">
        Precision Engineering.<br>
        <em>Built to Fly.</em>
      </h1>
      <p class="hero-sub fade-up d3">
        Aero Vector Engineering delivers <strong>aerospace-grade design, CNC manufacturing
        engineering, and technical consulting</strong> — the rigor of a full engineering
        department, scoped to exactly what your program needs.
      </p>
      <div class="hero-actions fade-up d4">
        <a href="/contact/" class="btn-primary">Start a Project</a>
        <a href="/services/" class="btn-ghost">View Services</a>
      </div>
    </div>
    <div class="hero-right fade-up d3">
      <svg class="hero-schematic" viewBox="0 0 420 420" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="210" cy="210" r="170" stroke="var(--border2)" stroke-width="1"/>
        <circle cx="210" cy="210" r="120" stroke="var(--border2)" stroke-width="1"/>
        <circle cx="210" cy="210" r="70" stroke="var(--border2)" stroke-width="1"/>
        <line x1="210" y1="10" x2="210" y2="410" stroke="var(--border)" stroke-width="1"/>
        <line x1="10" y1="210" x2="410" y2="210" stroke="var(--border)" stroke-width="1"/>
        <path d="M60 300 L150 230 L190 250 L340 90" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M310 100 L340 90 L328 122" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="60" cy="300" r="5" fill="var(--muted)"/>
        <circle cx="150" cy="230" r="5" fill="var(--muted)"/>
        <circle cx="190" cy="250" r="5" fill="var(--muted)"/>
        <path d="M150 230 L150 260" stroke="var(--muted2)" stroke-width="1" stroke-dasharray="3 3"/>
        <text x="152" y="278" fill="var(--muted2)" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="0.05em">X 150.00</text>
        <path d="M120 350 L300 350" stroke="var(--muted2)" stroke-width="1"/>
        <path d="M120 345 L120 355 M300 345 L300 355" stroke="var(--muted2)" stroke-width="1"/>
        <text x="165" y="368" fill="var(--muted2)" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="0.05em">180.00 mm</text>
      </svg>
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust-bar">
  <div class="trust-item"><span class="trust-dot"></span>Aerospace Engineering</div>
  <div class="trust-item"><span class="trust-dot"></span>Catia V5 Design</div>
  <div class="trust-item"><span class="trust-dot"></span>Vericut Verification</div>
  <div class="trust-item"><span class="trust-dot"></span>Manufacturing Consulting</div>
  <div class="trust-item"><span class="trust-dot"></span>Design Optimization</div>
</div>

<!-- WHAT WE BUILD -->
<div id="services" style="border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="section-header">
      <span class="section-num">01</span>
      <h2 class="section-title">What We<br><em>Do</em></h2>
    </div>
    <div class="section-rule"></div>
    <div class="services-grid services-grid--2col">
      <div class="service-card">
        <div class="service-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="16" rx="1"/><path d="M8 21h8M12 19v2"/><path d="M7 8l3 2-3 2M13 12h4"/></svg>
        </div>
        <span class="service-num">01</span>
        <div class="service-name">Design</div>
        <div class="service-desc">Aerospace-grade CAD modeling and detailed part design in Catia V5 — concept geometry through vendor-ready drawing packages.</div>
        <div class="service-tags"><span class="tag">Catia V5</span><span class="tag">GD&T</span><span class="tag">Sheet Metal</span></div>
        <span class="service-arrow">↗</span>
      </div>
      <div class="service-card">
        <div class="service-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="1"/><path d="M8 21h8M12 17v4"/><path d="M7 8h2v5H7zM11 6h2v7h-2zM15 10h2v3h-2z"/></svg>
        </div>
        <span class="service-num">02</span>
        <div class="service-name">Manufacturing Engineering</div>
        <div class="service-desc">CNC program development and toolpath verification in Vericut — catching collisions and overtravel before the spindle ever turns.</div>
        <div class="service-tags"><span class="tag">Vericut</span><span class="tag">CNC</span><span class="tag">First-Article</span></div>
        <span class="service-arrow">↗</span>
      </div>
      <div class="service-card">
        <div class="service-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18M3 12h13M3 18h8"/><path d="M18 15l3 3-3 3"/><circle cx="19" cy="9" r="2"/><path d="M17 9H9"/></svg>
        </div>
        <span class="service-num">03</span>
        <div class="service-name">Consult</div>
        <div class="service-desc">Independent engineering advisory — design reviews, root-cause investigations, and technical due diligence, without the overhead of a full-time hire.</div>
        <div class="service-tags"><span class="tag">Design Review</span><span class="tag">Audits</span><span class="tag">Advisory</span></div>
        <span class="service-arrow">↗</span>
      </div>
      <div class="service-card">
        <div class="service-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18M7 16l4-4 4 4 4-8"/></svg>
        </div>
        <span class="service-num">04</span>
        <div class="service-name">Optimize</div>
        <div class="service-desc">Design-for-manufacturability passes that reduce part count, cycle time, and scrap — tightening the gap between drawing and shop floor.</div>
        <div class="service-tags"><span class="tag">DFM</span><span class="tag">Tolerance Analysis</span><span class="tag">Cost Reduction</span></div>
        <a href="/services/" class="service-arrow" style="text-decoration:none;" aria-label="View Optimize on Services">↗</a>
      </div>
    </div>
    <div style="margin-top:32px;text-align:right;">
      <a href="/services/" class="btn-ghost">View All Services →</a>
    </div>
  </div>
</div>

<!-- HOW WE WORK -->
<div style="background:var(--bg2);border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="section-header">
      <span class="section-num">02</span>
      <h2 class="section-title">How We<br><em>Work</em></h2>
    </div>
    <div class="section-rule"></div>
    <div class="services-grid">
      <div class="service-card">
        <span class="service-num">01</span>
        <div class="service-desc">You send the form or email directly.</div>
      </div>
      <div class="service-card">
        <span class="service-num">02</span>
        <div class="service-desc">We reply within 24 hours with a few targeted questions.</div>
      </div>
      <div class="service-card">
        <span class="service-num">03</span>
        <div class="service-desc">A discovery call to assess fit and clarify what we'd need to see.</div>
      </div>
      <div class="service-card">
        <span class="service-num">04</span>
        <div class="service-desc">We review your drawings, data, or process documentation.</div>
      </div>
      <div class="service-card">
        <span class="service-num">05</span>
        <div class="service-desc">You receive a written proposal with scope, timeline, and price.</div>
      </div>
      <div class="service-card">
        <span class="service-num">06</span>
        <div class="service-desc">We align on scope, sign off on the proposal, and the work begins — defined timeline, clear deliverables, no surprises.</div>
      </div>
    </div>
    <div style="margin-top:32px;text-align:right;">
      <a href="/contact/" class="btn-ghost">Start a Project →</a>
    </div>
  </div>
</div>

<!-- CTA STRIP -->
<div style="background:var(--bg2);border-bottom:1px solid var(--border);padding:100px 48px;text-align:center;position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:400px;background:radial-gradient(ellipse,rgba(208,18,31,0.07) 0%,transparent 60%);pointer-events:none;"></div>
  <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);margin-bottom:20px;position:relative;z-index:1;">// Ready to Build</div>
  <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(48px,6vw,80px);line-height:0.92;text-transform:uppercase;color:var(--text);margin-bottom:20px;position:relative;z-index:1;">Design Your<br>Next Vector.</h2>
  <p style="font-size:16px;color:var(--muted);margin-bottom:44px;position:relative;z-index:1;">A free discovery call. We'll define the problem and figure out if there's a fit.</p>
  <div style="display:flex;gap:16px;justify-content:center;align-items:center;flex-wrap:wrap;position:relative;z-index:1;">
    <a href="/contact/" class="btn-primary">Start a Project</a>
  </div>
</div>

</Layout>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + 100px); padding-bottom: 100px;
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
    pointer-events: none;
  }
  .hero-glow { position: absolute; top: 15%; right: -5%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(208,18,31,0.08) 0%, transparent 65%); pointer-events: none; }
  .hero-inner {
    position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; padding: 0 48px; width: 100%;
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center;
  }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 28px; }
  .hero-eyebrow::before { content: ''; display: block; width: 28px; height: 1px; background: var(--accent); }
  .hero-headline { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: clamp(56px, 7vw, 92px); line-height: 0.9; letter-spacing: -0.01em; text-transform: uppercase; color: var(--text); margin-bottom: 32px; }
  .hero-headline em { font-style: normal; color: var(--accent); display: block; }
  .hero-sub { font-size: 17px; line-height: 1.7; color: var(--muted); margin-bottom: 44px; max-width: 540px; }
  .hero-sub strong { color: var(--text); font-weight: 500; }
  .hero-actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .hero-right { display: flex; justify-content: center; }
  .hero-schematic { width: 100%; max-width: 380px; height: auto; }
  .services-grid--2col { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 900px) {
    .hero-inner { padding: 40px 24px; grid-template-columns: 1fr; }
    .hero-right { order: -1; margin-bottom: 20px; }
    .hero-schematic { max-width: 280px; }
    .services-grid--2col { grid-template-columns: 1fr; }
  }
</style>
