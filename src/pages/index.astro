---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Aerospace Engineering — Design | Consult | Optimize" description="Aero Vector Engineering delivers aerospace-grade design, CNC manufacturing engineering, and consulting for teams that need precision without a full engineering department.">

<!-- DRAFT NOTICE — placeholder copy throughout, pending Trent's review -->

<!-- HERO — styled as a drawing sheet: dimensioned part outline + title block -->
<section class="hero frame">
  <span class="corner corner--tl" aria-hidden="true"></span>
  <span class="corner corner--tr" aria-hidden="true"></span>
  <span class="corner corner--bl" aria-hidden="true"></span>
  <span class="corner corner--br" aria-hidden="true"></span>
  <div class="blueprint-grid hero-grid" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-left">
      <div class="kicker fade-up d1">Freelance Aerospace Engineering</div>
      <h1 class="hero-headline fade-up d2">
        Precision Engineering.<br>
        <em>Built to Fly.</em>
      </h1>
      <p class="hero-sub fade-up d3">
        Aero Vector Engineering delivers <strong>aerospace-grade design, CNC manufacturing
        engineering, and technical consulting</strong> — the rigor of a full engineering
        department, scoped to exactly what your program needs.
      </p>
      <div class="hero-actions fade-up d4">
        <a href={`${base}contact/`} class="btn-primary">Start a Project</a>
        <a href={`${base}services/`} class="btn-ghost">View Services</a>
      </div>
    </div>
    <div class="hero-right fade-up d3">
      <svg class="hero-schematic" viewBox="0 0 460 360" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- airfoil/wing profile: cambered section, leading edge left, trailing edge right -->
        <path d="M50 180 C80 115 150 110 170 120 C260 145 350 165 410 180
                 C350 195 260 205 170 202 C140 200 90 192 50 180 Z"
              stroke="var(--muted2)" stroke-width="1.25" fill="none"/>
        <!-- chord line (leading edge to trailing edge) -->
        <line x1="50" y1="180" x2="410" y2="180" stroke="var(--muted2)" stroke-width="1" stroke-dasharray="4 4" opacity="0.6"/>

        <!-- chord-length dimension -->
        <line x1="50" y1="300" x2="410" y2="300" stroke="var(--accent3)" stroke-width="1"/>
        <line x1="50" y1="294" x2="50" y2="306" stroke="var(--accent3)" stroke-width="1"/>
        <line x1="410" y1="294" x2="410" y2="306" stroke="var(--accent3)" stroke-width="1"/>
        <rect x="200" y="290" width="60" height="18" fill="var(--bg)"/>
        <text x="230" y="303" text-anchor="middle" fill="var(--accent2)" font-family="IBM Plex Mono, monospace" font-size="11">360.00</text>

        <!-- max-thickness dimension -->
        <line x1="170" y1="120" x2="430" y2="120" stroke="var(--muted2)" stroke-width="1"/>
        <line x1="170" y1="202" x2="430" y2="202" stroke="var(--muted2)" stroke-width="1"/>
        <line x1="430" y1="120" x2="430" y2="202" stroke="var(--accent3)" stroke-width="1"/>
        <line x1="424" y1="120" x2="436" y2="120" stroke="var(--accent3)" stroke-width="1"/>
        <line x1="424" y1="202" x2="436" y2="202" stroke="var(--accent3)" stroke-width="1"/>
        <rect x="418" y="152" width="36" height="18" fill="var(--bg)"/>
        <text x="436" y="165" text-anchor="middle" fill="var(--accent2)" font-family="IBM Plex Mono, monospace" font-size="11" transform="rotate(-90 436 165)">82.00</text>

        <!-- leader callouts -->
        <line x1="50" y1="180" x2="30" y2="138" stroke="var(--muted2)" stroke-width="1"/>
        <circle cx="30" cy="138" r="2" fill="var(--muted2)"/>
        <circle cx="18" cy="110" r="13" stroke="var(--accent)" stroke-width="1.25" fill="var(--bg)"/>
        <text x="18" y="114" text-anchor="middle" fill="var(--accent2)" font-family="IBM Plex Mono, monospace" font-size="11">1</text>

        <line x1="170" y1="120" x2="210" y2="65" stroke="var(--muted2)" stroke-width="1"/>
        <circle cx="210" cy="65" r="2" fill="var(--muted2)"/>
        <circle cx="225" cy="50" r="13" stroke="var(--accent)" stroke-width="1.25" fill="var(--bg)"/>
        <text x="225" y="54" text-anchor="middle" fill="var(--accent2)" font-family="IBM Plex Mono, monospace" font-size="11">2</text>
      </svg>
    </div>
  </div>

  <div class="titleblock fade-up d5">
    <div class="tb-cell">
      <span class="tb-label">Discipline</span>
      <span class="tb-value">Aerospace Engineering</span>
    </div>
    <div class="tb-cell">
      <span class="tb-label">Tooling</span>
      <span class="tb-value">Catia V5 / Vericut</span>
    </div>
    <div class="tb-cell">
      <span class="tb-label">Engagement</span>
      <span class="tb-value">Project &amp; Consulting</span>
    </div>
    <div class="tb-cell">
      <span class="tb-label">Status</span>
      <span class="tb-value">Accepting New Work</span>
    </div>
  </div>
</section>

<!-- WHAT WE DO -->
<div id="services" style="border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="dwg-header">
      <div class="dwg-tag">01</div>
      <div class="dwg-leader"></div>
      <h2 class="dwg-title">What We Do</h2>
      <div class="dwg-rule"></div>
    </div>
    <div class="specsheet">
      <div class="ss-headrow">
        <span class="ss-h-item">Item</span>
        <span class="ss-h-name">Designation</span>
        <span>Description / Spec</span>
      </div>
      <div class="ss-row">
        <div class="ss-item">01</div>
        <div class="ss-body">
          <div class="ss-name">Design</div>
          <p class="ss-desc">Aerospace-grade CAD modeling and detailed part design in Catia V5 — concept geometry through vendor-ready drawing packages.</p>
          <div class="ss-spec"><span>Catia V5</span><span>GD&T</span><span>Sheet Metal</span></div>
        </div>
      </div>
      <div class="ss-row">
        <div class="ss-item">02</div>
        <div class="ss-body">
          <div class="ss-name">Manufacturing Engineering</div>
          <p class="ss-desc">CNC program development and toolpath verification in Vericut — catching collisions and overtravel before the spindle ever turns.</p>
          <div class="ss-spec"><span>Vericut</span><span>CNC</span><span>First-Article</span></div>
        </div>
      </div>
      <div class="ss-row">
        <div class="ss-item">03</div>
        <div class="ss-body">
          <div class="ss-name">Consult</div>
          <p class="ss-desc">Independent engineering advisory — design reviews, root-cause investigations, and technical due diligence, without the overhead of a full-time hire.</p>
          <div class="ss-spec"><span>Design Review</span><span>Audits</span><span>Advisory</span></div>
        </div>
      </div>
      <div class="ss-row">
        <div class="ss-item">04</div>
        <div class="ss-body">
          <div class="ss-name">Optimize</div>
          <p class="ss-desc">Design-for-manufacturability passes that reduce part count, cycle time, and scrap — tightening the gap between drawing and shop floor.</p>
          <div class="ss-spec"><span>DFM</span><span>Tolerance Analysis</span><span>Cost Reduction</span></div>
        </div>
      </div>
    </div>
    <div style="margin-top:28px;text-align:right;">
      <a href={`${base}services/`} class="btn-ghost">View All Services →</a>
    </div>
  </div>
</div>

<!-- HOW WE WORK -->
<div style="background:var(--bg2);border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="dwg-header">
      <div class="dwg-tag">02</div>
      <div class="dwg-leader"></div>
      <h2 class="dwg-title">How We Work</h2>
      <div class="dwg-rule"></div>
    </div>
    <div class="services-grid">
      <div class="service-card">
        <div class="balloon-row" style="margin-bottom:16px;"><div class="balloon">01</div></div>
        <div class="service-desc">You send the form or email directly.</div>
      </div>
      <div class="service-card">
        <div class="balloon-row" style="margin-bottom:16px;"><div class="balloon">02</div></div>
        <div class="service-desc">We reply within 24 hours with a few targeted questions.</div>
      </div>
      <div class="service-card">
        <div class="balloon-row" style="margin-bottom:16px;"><div class="balloon">03</div></div>
        <div class="service-desc">A discovery call to assess fit and clarify what we'd need to see.</div>
      </div>
      <div class="service-card">
        <div class="balloon-row" style="margin-bottom:16px;"><div class="balloon">04</div></div>
        <div class="service-desc">We review your drawings, data, or process documentation.</div>
      </div>
      <div class="service-card">
        <div class="balloon-row" style="margin-bottom:16px;"><div class="balloon">05</div></div>
        <div class="service-desc">You receive a written proposal with scope, timeline, and price.</div>
      </div>
      <div class="service-card">
        <div class="balloon-row" style="margin-bottom:16px;"><div class="balloon">06</div></div>
        <div class="service-desc">We align on scope, sign off on the proposal, and the work begins — defined timeline, clear deliverables, no surprises.</div>
      </div>
    </div>
    <div style="margin-top:28px;text-align:right;">
      <a href={`${base}contact/`} class="btn-ghost">Start a Project →</a>
    </div>
  </div>
</div>

<!-- CTA -->
<div class="cta-wrap">
  <div class="section">
    <div class="cta-panel frame">
      <span class="corner corner--tl" aria-hidden="true"></span>
      <span class="corner corner--tr" aria-hidden="true"></span>
      <span class="corner corner--bl" aria-hidden="true"></span>
      <span class="corner corner--br" aria-hidden="true"></span>
      <div class="kicker" style="justify-content:center;margin-bottom:18px;">Ready to Build</div>
      <h2 class="cta-headline">Design Your<br>Next Vector.</h2>
      <p class="cta-sub">A free discovery call. We'll define the problem and figure out if there's a fit.</p>
      <a href={`${base}contact/`} class="btn-primary">Start a Project</a>
    </div>
  </div>
</div>

</Layout>

<style>
  .hero {
    margin: 40px 48px 0; padding: 72px 48px 0;
    position: relative; overflow: hidden;
  }
  .hero-grid {
    mask-image: radial-gradient(ellipse 75% 65% at 50% 40%, black 20%, transparent 100%);
  }
  .hero-inner {
    position: relative; z-index: 2; margin: 0 auto; width: 100%; max-width: 1104px;
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 32px; align-items: center;
    padding-bottom: 56px;
  }
  .hero-headline {
    font-family: var(--f-display); font-weight: 700;
    font-size: clamp(42px, 5.2vw, 66px); line-height: 0.98; letter-spacing: 0.005em;
    text-transform: uppercase; color: var(--text); margin: 22px 0 26px;
  }
  .hero-headline em { font-style: normal; color: var(--accent); display: block; }
  .hero-sub { font-size: 16px; line-height: 1.7; color: var(--muted); margin-bottom: 36px; max-width: 520px; }
  .hero-sub strong { color: var(--text); font-weight: 500; }
  .hero-actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .hero-right { display: flex; justify-content: center; }
  .hero-schematic { width: 100%; max-width: 400px; height: auto; }
  .titleblock { position: relative; z-index: 2; border-top: 1px solid var(--border2); border-left: none; border-right: none; border-bottom: none; margin: 0 -48px; }
  .titleblock .tb-cell:first-child { padding-left: 48px; }
  .titleblock .tb-cell:last-child { padding-right: 48px; }

  .cta-wrap { background: var(--bg2); padding: 20px 0; }
  .cta-panel {
    padding: 64px 48px; text-align: center; background: var(--bg);
  }
  .cta-headline {
    font-family: var(--f-display); font-weight: 700;
    font-size: clamp(34px, 4vw, 50px); line-height: 1; text-transform: uppercase;
    color: var(--text); margin-bottom: 16px;
  }
  .cta-sub { font-size: 15px; color: var(--muted); margin-bottom: 32px; }

  @media (max-width: 900px) {
    .hero { margin: 24px 20px 0; padding: 48px 24px 0; }
    .hero-inner { grid-template-columns: 1fr; padding-bottom: 40px; }
    .hero-right { order: -1; margin-bottom: 12px; }
    .hero-schematic { max-width: 280px; }
    .titleblock { margin: 0 -24px; }
    .titleblock .tb-cell:first-child { padding-left: 24px; }
    .titleblock .tb-cell:last-child { padding-right: 24px; }
    .cta-panel { padding: 48px 24px; }
  }
</style>
