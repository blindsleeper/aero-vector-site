---
import Layout from '../layouts/Layout.astro';

const stack = [
  { letter: 'A', name: 'Catia V5',       role: 'CAD modeling & product design'       },
  { letter: 'B', name: 'Vericut',        role: 'CNC simulation & toolpath verification' },
  { letter: 'C', name: 'Dassault Systèmes', role: 'Production tooling & shop systems'   },
  { letter: 'D', name: 'GD&T',           role: 'Tolerancing & drawing standards'     },
];

const steps = [
  {
    num:  '01',
    name: 'Discovery',
    desc: 'A focused call to understand the part, the process, and what already exists. No pitch — just listening.',
  },
  {
    num:  '02',
    name: 'Proposal',
    desc: 'A written scope with clear deliverables, timeline, and price. No vague estimates. No surprise overages.',
  },
  {
    num:  '03',
    name: 'Build',
    desc: 'Iterative delivery with milestone check-ins. You see work before the finish line — not just at it.',
  },
  {
    num:  '04',
    name: 'Deliver',
    desc: 'Clean handoff with drawings, documentation, and first-article support. You own it completely.',
  },
];
---

<Layout title="About" description="Aero Vector Engineering is an aerospace design, manufacturing engineering, and consulting practice founded by Trent Wieberg — built on precision, documentation, and engineering you can build on.">

<!-- DRAFT NOTICE — placeholder bio copy, pending Trent's review -->

<!-- ── PAGE HERO ── -->
<section class="page-hero">
  <div class="blueprint-grid page-hero-grid" aria-hidden="true"></div>
  <div class="page-hero-inner">
    <div class="kicker fade-up d1">About Aero Vector Engineering</div>
    <h1 class="page-headline fade-up d2">
      Engineering You<br><em>Can Build On.</em>
    </h1>
  </div>
</section>

<!-- ── IDENTITY ── -->
<div style="border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="dwg-header">
      <div class="dwg-tag">01</div>
      <div class="dwg-leader"></div>
      <h2 class="dwg-title">Who We Are</h2>
      <div class="dwg-rule"></div>
    </div>

    <div class="identity-body">

      <!-- Left: about copy -->
      <div class="identity-copy">
        <p class="identity-para">
          Aero Vector Engineering is an aerospace design and manufacturing engineering
          practice founded by Trent Wieberg, built on a simple premise: precision isn't
          a luxury add-on to engineering — it's the job.
        </p>
        <p class="identity-para">
          We work at the intersection of design and the shop floor. A drawing that looks
          correct on screen and a part that machines cleanly are two different problems,
          and most of the friction in aerospace manufacturing lives in the gap between
          them. We close that gap — modeling in Catia V5, verifying toolpaths in Vericut,
          and building the tooling and systems that keep a process repeatable once it's
          running.
        </p>
        <p class="identity-para">
          We're a small, growing team by design. Every engagement gets direct engineering
          attention — not an account manager relaying questions to someone else. As the
          practice grows, that standard doesn't change: fewer handoffs, clearer
          documentation, and work you can trace from drawing to delivered part.
        </p>
        <p class="identity-para">
          The result is infrastructure — drawings, programs, and fixtures — that holds up
          under audit and under load, documented well enough that it outlasts any single
          engineer's involvement.
        </p>
        <div class="dim-row">
          <div class="dim-cell"><span class="dim-val">Direct</span><span class="dim-label">Engineering access</span></div>
          <div class="dim-cell"><span class="dim-val">Fixed</span><span class="dim-label">Scoped pricing</span></div>
          <div class="dim-cell"><span class="dim-val">Documented</span><span class="dim-label">Every deliverable</span></div>
        </div>
      </div>

      <!-- Right: software / tooling stack -->
      <div class="stack-block">
        <div class="kicker" style="margin-bottom:18px;">Engineering Stack</div>
        <div class="stack-list">
          {stack.map((item) => (
            <div class="stack-item">
              <div class="datum-box">{item.letter}</div>
              <div class="stack-detail">
                <div class="stack-name">{item.name}</div>
                <div class="stack-role">{item.role}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</div>

<!-- ── HOW WE WORK ── -->
<div style="background: var(--bg2); border-bottom: 1px solid var(--border);">
  <div class="section">
    <div class="dwg-header">
      <div class="dwg-tag">02</div>
      <div class="dwg-leader"></div>
      <h2 class="dwg-title">How We Work</h2>
      <div class="dwg-rule"></div>
    </div>

    <div class="process-track">
      {steps.map((step, i) => (
        <div class="process-step">
          <div class="balloon-row" style="margin-bottom:20px;">
            <div class="balloon">{step.num}</div>
            {i < steps.length - 1 && (
              <div class="dwg-rule process-connector" aria-hidden="true"></div>
            )}
          </div>
          <div class="process-name">{step.name}</div>
          <p class="process-desc">{step.desc}</p>
        </div>
      ))}
    </div>

  </div>
</div>

<!-- ── CTA ── -->
<div class="cta-wrap">
  <div class="section">
    <div class="cta-panel frame">
      <span class="corner corner--tl" aria-hidden="true"></span>
      <span class="corner corner--tr" aria-hidden="true"></span>
      <span class="corner corner--bl" aria-hidden="true"></span>
      <span class="corner corner--br" aria-hidden="true"></span>
      <div class="kicker" style="justify-content:center;margin-bottom:18px;">Let's Build Something</div>
      <h2 class="cta-headline">Ready to Get<br><em>Started?</em></h2>
      <p class="cta-sub">
        Discovery calls are free. Come with a part, a process, or a problem — leave
        knowing whether we're the right fit to solve it.
      </p>
      <div class="cta-actions">
        <a href="/contact/" class="btn-primary">Start a Project</a>
        <a href="/services/" class="btn-ghost">View Services</a>
      </div>
    </div>
  </div>
</div>

</Layout>

<style>
  /* ── PAGE HERO ── */
  .page-hero {
    min-height: 40vh;
    padding-top: var(--nav-h);
    display: flex; align-items: center;
    position: relative; overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .page-hero-grid {
    mask-image: radial-gradient(ellipse 85% 75% at 50% 50%, black 15%, transparent 100%);
  }
  .page-hero-inner {
    position: relative; z-index: 2;
    max-width: 1200px; margin: 0 auto;
    padding: 72px 48px; width: 100%;
  }
  .page-headline {
    font-family: var(--f-display); font-weight: 700;
    font-size: clamp(40px, 5.5vw, 64px);
    line-height: 1; letter-spacing: 0.005em;
    text-transform: uppercase; color: var(--text);
    margin-top: 20px;
  }
  .page-headline em { font-style: normal; color: var(--accent); display: block; }

  /* ── IDENTITY ── */
  .identity-body {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 72px;
    align-items: start;
  }
  .identity-para {
    font-size: 15px; line-height: 1.8; color: var(--muted);
    margin-bottom: 22px;
  }
  .identity-para:last-of-type { margin-bottom: 36px; }

  /* ── STACK ── */
  .stack-block {
    position: sticky; top: calc(var(--nav-h) + 24px);
  }
  .stack-list {
    border: 1px solid var(--border);
    background: var(--border);
    display: flex; flex-direction: column; gap: 1px;
  }
  .stack-item {
    background: var(--bg3);
    display: flex; align-items: center; gap: 16px;
    padding: 16px 20px;
    transition: background 0.25s;
    cursor: default;
  }
  .stack-item:hover { background: var(--bg4); }
  .stack-detail { flex: 1; min-width: 0; }
  .stack-name {
    font-family: var(--f-display); font-weight: 700; font-size: 16px;
    letter-spacing: 0.02em; text-transform: uppercase;
    color: var(--text); line-height: 1; margin-bottom: 4px;
  }
  .stack-role {
    font-family: var(--f-mono); font-size: 9px; letter-spacing: 0.04em;
    color: var(--muted2);
  }

  /* ── PROCESS STEPS ── */
  .process-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0 32px;
  }
  .process-connector { flex: 1; margin-left: 12px; }
  .process-name {
    font-family: var(--f-display); font-weight: 700; font-size: 20px;
    letter-spacing: 0.02em; text-transform: uppercase;
    color: var(--text); margin-bottom: 10px;
  }
  .process-desc {
    font-size: 13px; line-height: 1.7;
    color: var(--muted);
  }

  /* ── CTA ── */
  .cta-wrap { background: var(--bg); padding: 20px 0; }
  .cta-panel { padding: 64px 48px; text-align: center; background: var(--bg2); }
  .cta-headline {
    font-family: var(--f-display); font-weight: 700;
    font-size: clamp(34px, 4vw, 50px); line-height: 1; text-transform: uppercase;
    color: var(--text); margin-bottom: 16px;
  }
  .cta-headline em { font-style: normal; color: var(--accent); display: block; }
  .cta-sub {
    font-size: 15px; color: var(--muted); margin-bottom: 32px;
    max-width: 420px; margin-inline: auto; line-height: 1.7;
  }
  .cta-actions { display: flex; gap: 14px; justify-content: center; align-items: center; flex-wrap: wrap; }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .identity-body { grid-template-columns: 1fr; gap: 48px; }
    .stack-block { position: static; }
  }
  @media (max-width: 900px) {
    .page-hero-inner { padding: 56px 24px; }
    .process-track { grid-template-columns: 1fr 1fr; gap: 32px 24px; }
    .process-connector { display: none; }
    .cta-panel { padding: 48px 24px; }
  }
  @media (max-width: 540px) {
    .process-track { grid-template-columns: 1fr; }
  }
</style>
